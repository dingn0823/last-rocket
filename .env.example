# Copy to .env and fill in. Never commit .env.
PORT=3000
# Public https URL from Cloudflare Tunnel / ngrok (optional, used in links)
PUBLIC_URL=
# Gemini free tier (optional — without it the game uses keyword matching + numbered options)
GEMINI_API_KEY=
# Leave empty for the default fast models; or a comma-separated fallback list
GEMINI_MODEL=
# 1 = event mode: stages 2–5 always show numbered options (no AI parsing)
EVENT_MODE=0
# Photon Spectrum (iMessage). Leave empty to use only the web phone simulator.
PROJECT_ID=
PROJECT_SECRET=
# PHOTON=0 turns iMessage off even when credentials are set
# Fixed short link on GitHub Pages that follows the tunnel (repo holds shortlink/index.html + url.json)
SHORTLINK_REPO=
SHORTLINK_URL=
# Automatic rounds for the finals (or switch them on in the host console): ROUNDS=auto
ROUNDS=
ROUND_BOARDING_SECONDS=30
ROUND_MINUTES=10
ROUND_CEREMONY_SECONDS=45

